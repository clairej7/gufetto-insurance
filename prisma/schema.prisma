generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// CRM tables
model Copro {
  id          String  @id @default(cuid())
  buildingId  String  @unique // Duomo ID
  nom         String
  adresse     String?

  gestionnaireEmail String?
  // Nom du gestionnaire (Omni "AM/PM Name"). L'email reste la clé technique
  // (filtres, assignation, signatures) ; ce nom sert uniquement à l'affichage.
  gestionnaireNom   String?
  // Etat du deal MRI côté HubSpot (Omni "Insurance Business State Groups") :
  // "Insurance client" = déjà cliente MRI Matera (dossier clos, sauf assureur
  // Wakam qu'il faut migrer) ; "Not MRI client yet" = dossier à traiter.
  // Source de vérité prioritaire sur le sales status (Duomo). Toujours rafraîchi.
  clientMriStatut   String?

  // Contrat d'assurance actuel
  assureurActuel    String?
  numeroContrat     String?
  courtierActuel    String?
  primeActuelle     Float?
  // Automatisation 8 « clean prime » : true quand la prime a été récupérée
  // automatiquement (Front) mais sans certitude → l'UI affiche « montant récupéré
  // automatiquement, vérifier ». Repassé à false dès qu'un gestionnaire édite la prime.
  primeAVerifier    Boolean @default(false)
  // Auto 8 : horodatage de la dernière tentative de récupération de prime (batch).
  // Curseur persistant → le batch ne retente pas les dossiers déjà vus (trouvés ou
  // non) : les « 10 suivants » sont toujours de nouveaux dossiers.
  primeVerifTenteLe DateTime?
  dateEcheance      DateTime?
  dateDebutContrat  DateTime?

  // Contact courtier / assureur
  contactCourtierEmail  String?
  contactCourtierTel    String?

  // Cliquet données contrat : posé dès qu'un gestionnaire édite les blocs
  // "Contrat actuel" / "Infos copropriété" → les syncs Omni ne touchent plus
  // jamais aux champs contrat de cette copro (l'échéance reste rafraîchie).
  contratVerrouilleLe DateTime?
  // Cliquet échéance : posé quand un gestionnaire édite l'échéance à la main.
  // La synchro Omni ne réécrit alors plus dateEcheance (fait immeuble normalement
  // rafraîchi à chaque sync).
  echeanceVerrouilleLe DateTime?

  // Automatisation 8 « clean avis d'échéance » : dossier dont l'échéance est dépassée
  // depuis plusieurs mois/années → donnée jugée périmée (import Omni ancien). Flag posé
  // par « Trouver tous les dossiers aux données périmées » ; retiré dès qu'une donnée
  // plus récente est retrouvée dans Front (assureur / courtier / prime / échéance).
  donneePerimee       Boolean @default(false)
  // Curseur : dernière tentative de récupération d'un dossier périmé (batch) → les
  // tranches suivantes ne reprennent que de nouveaux dossiers.
  perimeeVerifTenteLe DateTime?
  // Horodatage de résolution (donnée plus récente retrouvée) → compteur « résolus ».
  perimeeResolvedAt   DateTime?

  // Automatisation 8 volet 3 « correction GetHumanCall » : provenance par champ.
  // ghcFields = liste JSON des champs issus de l'import GHC (["assureur","prime",
  // "courtier","numero","echeance"]) → check vert « GHC » sur la fiche. Vidé si un
  // gestionnaire ré-édite le bloc contrat (on ne revendique plus la source GHC).
  ghcImportedAt DateTime?
  ghcFields     String?

  // Contact Conseil Syndical
  contactCsEmail String?
  contactCsNom   String?

  // Caractéristiques de l'immeuble
  surfaceDeveloppee           Float?
  periodeConstruction         String? // "avant_1950" | "1950_1970" | "1970_1985" | "1985_2000" | "apres_2000" | "inconnue"
  natureOccupation            String? // "habitation" | "mixte" | "professionnelle"
  activitesAggravantes        String?
  caracteristiquesParticulieres String?
  proportionInoccupee         String? // "moins_25" | "25_50" | "50_75" | "plus_75"
  protectionJuridique         String? // "oui" | "non"
  assureursDevis              String? // JSON: ["axa"] | ["mila"] | ["axa","mila"]
  representantLegal           String?
  duomoUrl                    String?

  // Sync metadata
  source    String    @default("omni") // "omni" | "duomo"
  syncedAt  DateTime  @default(now())
  archivedAt DateTime? // copro absente du dernier inventaire Omni complet — conservée, masquée des vues actives

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipelines InsurancePipeline[]
}

enum PipelineStatut {
  identifie
  odr_en_cours
  odr_envoye
  odr_accepte
  odr_en_vigueur
  rs_en_cours
  rs_recu
  devis_demandes
  devis_recus
  envoye_cs
  validation_cs
  contrat_signe
  resiliation_envoyee
  sepa_complete
  termine
  abandonne
  refuse
  non_assurable
}

model InsurancePipeline {
  id             String         @id @default(cuid())
  coproId        String
  copro          Copro          @relation(fields: [coproId], references: [id], onDelete: Cascade)
  statut         PipelineStatut @default(identifie)
  anneeEcheance  Int
  notes             String?        @db.Text
  contratActuelData String?        @db.Text
  signedPdfUrl      String?        @db.Text

  // Données extraites du contrat signé
  nouveauNumeroContrat    String?
  nouveauDateEffet        DateTime?
  nouveauPrimeTTC         Float?

  // Marqueur ODR persistant : partenaire chez qui un Ordre de Remplacement a été
  // engagé ("AXA" / "GENERALI" / "SADA" / "MILA"). Indépendant du statut → permet
  // de suivre les ODR à travers toutes les étapes (y compris une fois clos), là où
  // l'assureur seul ne suffit pas (un clos AXA n'est pas forcément un ODR).
  odrPartenaire           String?

  // Dernière tentative d'autofill (automatisation 1). Sert de curseur persistant :
  // le batch exclut les dossiers tentés récemment → il avance dans le stock au
  // lieu de re-traiter les mêmes non-fiables à chaque clic. Re-tenté après un délai.
  autofillTenteLe DateTime?

  // Automatisation 3 → 4 : dossier de l'échantillon « clean » chargé pour l'envoi
  // automatique de la demande de RS (auto 4). Posé par « Envoyer l'échantillon
  // clean à l'automatisation 4 ». Consommé/retiré une fois la RS envoyée.
  rsBatchAt DateTime?

  // Auto 4 Volet 1 → Volet 2 : dossier « infos complètes » validé et passé au
  // volet d'envoi des mails. Posé par « Passer les X dossiers complets au volet 2 ».
  rs4Volet2At DateTime?
  // Auto 4 Volet 2 → Volet 3 : date d'envoi de la demande de RS (ou date de l'envoi
  // d'origine pour les dossiers déjà relancés). Sert de point de départ au compteur
  // « X jours depuis l'envoi » et à l'éligibilité des relances. Sortie de la boucle
  // quand le RS est reçu (le dossier quitte rs_en_cours).
  rs4SentAt DateTime?
  // Auto 4 Volet 3 → Volet 4 : le courtier a répondu mais le RS n'est pas encore
  // reçu (demande d'info, etc.) → sorti de la boucle de relance, placé en « RS en
  // cours de récupération ». Reste jusqu'au RS reçu (→ devis_demandes).
  rs4EnCoursAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events          PipelineEvent[]
  taskCompletions TaskCompletion[]
  devisRecus      DevisRecu[]
  tasks           Task[]
}

model Task {
  id            String            @id @default(cuid())
  // Optionnel : une tâche peut être transverse (backlog projet / clean data) sans
  // dossier rattaché — elle s'affiche alors comme « Général » dans l'onglet Tâches.
  pipelineId    String?
  pipeline      InsurancePipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name          String
  body          String?   @db.Text
  status        String    @default("todo") // "todo" | "done"
  assigneeEmail String
  dueDate       DateTime?

  completedAt   DateTime?
  completedBy   String?

  createdAt     DateTime  @default(now())
  createdBy     String
}

model DevisRecu {
  id            String            @id @default(cuid())
  pipelineId    String
  pipeline      InsurancePipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  assureur      String
  numeroContrat String?
  primeTTC      Float
  data          String?           @db.Text
  notes         String?           @db.Text
  pdfName       String?
  pdfUrl        String?           @db.Text
  recommande    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum EventType {
  statut_change
  note_ajoutee
  tache_completee
  action_manuelle
  sync_auto
}

model PipelineEvent {
  id         String    @id @default(cuid())
  pipelineId String
  pipeline   InsurancePipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  type          EventType
  ancienStatut  String?
  nouveauStatut String?
  description   String    @db.Text
  metadata      Json?

  createdBy String // email du gestionnaire
  createdAt DateTime @default(now())
}

// Tâches prédéfinies par étape (seed data)
model StageTaskTemplate {
  id          String         @id @default(cuid())
  statut      PipelineStatut
  label       String
  shortLabel  String?
  actionType  String?        // "email" | "document" | "waiting" | "signature" | "update" | "other"
  description String?
  required    Boolean        @default(true)
  order       Int

  completions TaskCompletion[]
}

model TaskCompletion {
  id         String @id @default(cuid())
  pipelineId String
  pipeline   InsurancePipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  taskId     String
  task       StageTaskTemplate @relation(fields: [taskId], references: [id])

  completedBy String // email
  completedAt DateTime @default(now())
  note        String?

  @@unique([pipelineId, taskId])
}

model UserLoginEvent {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())
}

// Trace de chaque exécution des webhooks Omni (sync nocturne).
// Permet à l'onglet admin "Synchro" de montrer ce qui tourne la nuit.
// source : "omni" | "omni-contrats" | "omni-infos-copro"
// status : "processing" | "success" | "error"
model SyncRun {
  id           String    @id @default(cuid())
  source       String
  status       String    @default("processing")
  rowsReceived Int       @default(0)
  result       Json?
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([source, startedAt])
  @@index([startedAt])
}

// Historique de l'automatisation 8 « clean prime ». 1 ligne = un instantané (baseline
// initiale, puis un par run de vérification en masse) : état du stock (dossiers sans
// prime / total, primes connues à date) + ce que le run a apporté (résolus, montant).
model PrimeCleanRun {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  totalDossiers    Int      // dossiers actifs (non archivés)
  sansPrime        Int      // dossiers sans prime à cette date
  primeConnueTotal Float    // somme des primes connues à cette date
  resolved         Int      @default(0) // dossiers pour lesquels une prime a été trouvée par CE run
  montantAdded     Float    @default(0) // montant de primes ajouté par CE run
  createdBy        String?

  @@index([createdAt])
}

// Historique du volet « clean avis d'échéance » (données périmées) : un instantané
// par run de vérification. `resolved` = delta de dossiers dé-périmés par CE run.
model PerimeCleanRun {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  concerned     Int      // dossiers flagués « donnée périmée » à cette date
  resolvedTotal Int      // cumul des dossiers résolus (perimeeResolvedAt != null)
  resolved      Int      @default(0) // dossiers résolus par CE run (delta)
  createdBy     String?

  @@index([createdAt])
}

// Volet 3 « correction GetHumanCall » — données SOURCE issues de l'excel GHC
// (agents Get Human Call qui ont appelé les assureurs). Clé = building_id normalisé.
// Rechargée à chaque nouvelle version de l'excel.
model GhcContract {
  buildingId    String  @id
  buildingName  String?
  assureur      String?
  courtier      String?
  numeroContrat String?
  montant       Float?
  echeance      DateTime?
  aVerifier     Boolean @default(false) // colonne « A vérifier » côté GHC
  updatedAt     DateTime @updatedAt
}

// Historique des imports GHC (une ligne par « Appliquer GHC »). Le volet 3 affiche
// l'excel source + la date + le détail ; la v2 ajoutera simplement une ligne.
model GhcImportRun {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  label          String   // ex. "v1"
  fileName       String?
  dossiersClean  Int      @default(0)
  assureursMaj   Int      @default(0)
  primesMaj      Int      @default(0)
  courtiersMaj   Int      @default(0)
  numerosMaj     Int      @default(0)
  echeancesMaj   Int      @default(0)
  versOdr        Int      @default(0)
  versRs         Int      @default(0)
  divergences    Int      @default(0)
  casParticuliers Int     @default(0)
  createdBy      String?

  @@index([createdAt])
}

// Rapport de divergences + cas particuliers d'un import GHC (contrôle humain).
model GhcReview {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  importRunId String?
  buildingId  String
  coproNom    String
  kind        String   // "prime_divergente" | "odr_conflit" | "rs_vers_odr"
  message     String
  resolved    Boolean  @default(false)

  @@index([createdAt])
  @@index([kind])
}

// Automatisation 3 — base de référence des courtiers/cabinets et de leur mail type.
// Sert à (1) reconnaître qu'un « assureur » est en réalité un courtier, (2) compléter
// le mail courtier manquant avant l'envoi des demandes de RS (auto 4). Alimentée par
// la liste fournie par Quentin + un scraping des mails courtier vus dans Front.
model CourtierRef {
  id          String   @id @default(cuid())
  nom         String   // nom du courtier / cabinet (tel qu'affiché)
  nomNorm     String   // nom normalisé (minuscule, sans accents) — clé de rapprochement
  type        String   @default("courtier") // "courtier" | "assureur" (garde-fou : ne pas demander le RS à une compagnie)
  email       String?  // mail type / de contact du courtier
  emailsAll   String?  // tous les mails connus, séparés par ";" (le 1er = principal)
  assureur    String?  // compagnie(s) associée(s), optionnel
  source      String   @default("manuel") // "manuel" | "import" | "front"
  occurrences Int      @default(0) // nb d'apparitions (ex. vu N fois dans Front)
  verifie     Boolean  @default(false) // email vérifié / validé manuellement
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([nomNorm])
}

// Automatisation 3 → 4 : historique des envois de l'échantillon clean vers
// l'auto 4 (date + nombre de dossiers), pour garder une trace.
model RsBatchLog {
  id         String   @id @default(cuid())
  sentAt     DateTime @default(now())
  count      Int
  actorEmail String?
}

// Automatisation 4 : historique des envois de mails (demandes de RS + relances)
// aux courtiers, pour garder une trace datée.
model Rs4SendLog {
  id         String   @id @default(cuid())
  sentAt     DateTime @default(now())
  kind       String // "initial" | "relance"
  relanceNum Int? // n° de relance si kind = "relance"
  count      Int // mails envoyés
  failed     Int    @default(0) // échecs
  actorEmail String?
}
