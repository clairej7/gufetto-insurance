# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="https://crm-assurance.matera.eu"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (Google Workspace @matera.eu)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Omni API
OMNI_API_URL="https://your-omni-instance.omniapp.co"
OMNI_API_KEY="your-omni-api-key"
OMNI_MODEL_ID="your-model-id"

# Cron security
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Duomo webhook
DUOMO_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# Admins (comma-separated emails)
ADMIN_EMAILS="claire.jaquemet@matera.eu"
